│                                                                                                                                                              │
│  Keyboard Shortcuts                                                                                                                                          │
│                                                                                                                                                              │
│                                                                                                                                                              │
│    ENTER  — Load lineages / view detail                                                                                                                      │
│    R  — Refresh lineage list                                                                                                                                 │
│    ↑↓  — Navigate lineages                                                                                                                                   │
│    ESC  — Back to list / main menu                                                                                                                           │
│                                                                                                                                                              │
│                                                                                                                                                              │
│  Press ? or ESC to close help                                                                                                                                │
