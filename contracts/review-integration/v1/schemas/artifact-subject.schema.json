{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biggz-ai.dev/contracts/review-integration/v1/schemas/artifact-subject.schema.json",
  "title": "Biggz AI artifact subject",
  "description": "The provider-owned identity of one reviewer execution: lineage, expected authority revision (event chain head), reviewed commit, immutable base/candidate trees, ordered path manifest digest, and the selected lens slot. The subject_hash binds all of it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "subject_hash",
    "lineage_id",
    "authority_revision",
    "target_identity",
    "base_tree",
    "candidate_tree",
    "changed_path_manifest_sha256",
    "lens",
    "selected_order"
  ],
  "properties": {
    "schema": {"const": "biggz-ai.review-artifact-subject/v1"},
    "subject_hash": {"$ref": "#/$defs/sha256"},
    "lineage_id": {"type": "string", "minLength": 1},
    "authority_revision": {"$ref": "#/$defs/sha256_hex"},
    "target_identity": {"$ref": "#/$defs/git_sha"},
    "base_tree": {"$ref": "#/$defs/git_tree"},
    "candidate_tree": {"$ref": "#/$defs/git_tree"},
    "changed_path_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "lens": {"$ref": "#/$defs/lens"},
    "selected_order": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sha256_hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "git_tree": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "lens": {"enum": ["risk", "readability", "reliability", "resilience", "performance", "dependencies"]}
  }
}
