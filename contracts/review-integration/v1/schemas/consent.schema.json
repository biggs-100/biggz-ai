{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biggz-ai.dev/contracts/review-integration/v1/schemas/consent.schema.json",
  "title": "Biggz AI relayed review consent question",
  "description": "The typed per-candidate consent question `biggz review start --consent relay` prints: why input is required, the complete choice set, and the exact runnable follow-up invocations (granted then declined, prefixItems discipline). A decline is scoped to that candidate and is deliberately not the kill switch; the permanent disable stays a documented off path outside the choice set.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "headline", "reason", "risk_evidence", "candidate", "choices", "off_path_note"],
  "properties": {
    "schema": {"const": "biggz-ai.review-consent/v1"},
    "headline": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "risk_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "candidate": {"$ref": "#/$defs/candidate"},
    "choices": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"$ref": "#/$defs/choice_granted"},
        {"$ref": "#/$defs/choice_declined"}
      ],
      "items": false
    },
    "off_path_note": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "lens": {"enum": ["risk", "readability", "reliability", "resilience", "performance", "dependencies"]},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit_sha", "lineage", "risk", "lenses"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
        "lineage": {"type": "string", "minLength": 1},
        "risk": {"enum": ["low", "medium", "high"]},
        "lenses": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/lens"}
        }
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "effect"],
      "properties": {
        "id": {"enum": ["granted", "declined"]},
        "label": {"type": "string", "minLength": 1},
        "effect": {"type": "string", "minLength": 1},
        "invocation": {"type": "string", "minLength": 1}
      }
    },
    "choice_granted": {
      "allOf": [{"$ref": "#/$defs/choice"}],
      "properties": {"id": {"const": "granted"}}
    },
    "choice_declined": {
      "allOf": [{"$ref": "#/$defs/choice"}],
      "properties": {"id": {"const": "declined"}}
    }
  }
}
