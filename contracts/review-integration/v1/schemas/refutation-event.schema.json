{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biggz-ai.dev/contracts/review-integration/v1/schemas/refutation-event.schema.json",
  "title": "Biggz AI refutation event payload",
  "description": "The durable `refutation` event payload appended to the lineage when the refuter batch is registered.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "lineage_id", "verdicts"],
  "properties": {
    "schema": {"const": "biggz-ai.review-refutation-event/v1"},
    "lineage_id": {"type": "string", "minLength": 1},
    "verdicts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/verdict"}
    }
  },
  "$defs": {
    "finding_id": {"type": "string", "pattern": "^R[1-6]-[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "verdict", "evidence"],
      "properties": {
        "finding_id": {"$ref": "#/$defs/finding_id"},
        "verdict": {"enum": ["refuted", "stands"]},
        "evidence": {"type": "string", "minLength": 1}
      }
    }
  }
}
