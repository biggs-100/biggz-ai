{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biggz-ai.dev/contracts/review-integration/v1/schemas/lens-result-event.schema.json",
  "title": "Biggz AI lens result event payload",
  "description": "The durable `lens_result` event payload: the canonicalized reviewer payload plus the manifest reference. canonical_payload is opaque by design (the canonical admission envelope, not formalized here); its identity is the canonical_payload_sha256 content address.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "lineage_id",
    "expected_revision",
    "subject_hash",
    "lens",
    "selected_order",
    "admission_decision",
    "inspection",
    "canonical_payload",
    "canonical_payload_sha256",
    "result_hash",
    "candidate_causal_finding_ids",
    "manifest_sha256",
    "manifest_path",
    "result"
  ],
  "properties": {
    "schema": {"const": "biggz-ai.review-lens-result-event/v1"},
    "lineage_id": {"type": "string", "minLength": 1},
    "expected_revision": {"$ref": "#/$defs/sha256_hex"},
    "subject_hash": {"$ref": "#/$defs/sha256"},
    "lens": {"$ref": "#/$defs/lens"},
    "selected_order": {"type": "integer", "minimum": 0},
    "admission_decision": {
      "enum": ["completed", "incomplete", "ambiguous", "out_of_scope", "binding_mismatch"]
    },
    "inspection": {"$ref": "#/$defs/inspection"},
    "canonical_payload": {"type": "object"},
    "canonical_payload_sha256": {"$ref": "#/$defs/sha256"},
    "result_hash": {"$ref": "#/$defs/sha256"},
    "candidate_causal_finding_ids": {"type": "array", "items": {"$ref": "#/$defs/finding_id"}},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_path": {"type": "string", "minLength": 1},
    "result": {"$ref": "#/$defs/lens_result"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sha256_hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lens": {"enum": ["risk", "readability", "reliability", "resilience", "performance", "dependencies"]},
    "finding_id": {"type": "string", "pattern": "^R[1-6]-[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "inspection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "paths"],
      "properties": {
        "status": {"const": "completed"},
        "paths": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/finding_id"},
        "lens": {"$ref": "#/$defs/lens"},
        "location": {"type": "string", "minLength": 1},
        "severity": {"enum": ["BLOCKER", "CRITICAL", "WARNING", "SUGGESTION"]},
        "claim": {"type": "string", "minLength": 1},
        "proof_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence_class": {"enum": ["deterministic", "inferential", "insufficient"]},
        "causal_disposition": {
          "enum": ["introduced", "behavior-activated", "worsened", "pre-existing", "base-only", "unknown"]
        }
      }
    },
    "lens_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lens", "findings", "evidence"],
      "properties": {
        "lens": {"$ref": "#/$defs/lens"},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "result_hash": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
