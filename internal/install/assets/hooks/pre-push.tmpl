#!/bin/sh
# biggz:rdd-gate
# Auto-generated by biggz install — do not edit manually.
set -e
if [ "$SKIP_RDD_GATE" = "1" ]; then
  git_common=$(git rev-parse --git-common-dir 2>/dev/null || echo ".git")
  audit_path="$git_common/biggz/rdd-audit.log"
  mkdir -p "$(dirname "$audit_path")"
  ts=$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || date)
  # Fail-closed audit: the `|| rdd_out="enabled"` fallback is pinned — only an
  # explicit, successful "RDD Status: disabled" may record disabled; an absent
  # or failing producer records enabled, never disabled.
  rdd_out=$(biggz rdd status 2>/dev/null) || rdd_out="enabled"
  rdd_mode="enabled"
  case "$rdd_out" in
    *"RDD Status: disabled"*) rdd_mode="disabled" ;;
  esac
  printf '{"ts":"%s","hook":"pre-push","bypass":true,"git_dir":"%s","rdd":"%s"}\n' "$ts" "$git_common" "$rdd_mode" >> "$audit_path" 2>/dev/null || true
  exit 0
fi
git_common=$(git rev-parse --git-common-dir 2>/dev/null || echo ".git")
lineage=""
if [ -d "$git_common/biggz/review-transactions" ]; then
  candidates=$(ls -t "$git_common/biggz/review-transactions" 2>/dev/null || true)
  for cand in $candidates; do
    dir="$git_common/biggz/review-transactions/$cand"
    [ -d "$dir" ] || continue
    head_file="$dir/HEAD"
    [ -f "$head_file" ] || continue
    head_hash=$(cat "$head_file" 2>/dev/null | tr -d '\r\n' | head -n1)
    [ -n "$head_hash" ] || continue
    event_file="$dir/$head_hash"
    [ -f "$event_file" ] || event_file="$dir/v1/events/$head_hash"
    [ -f "$event_file" ] || continue
    commit=$(grep -o '"commit_sha":"[^"]*"' "$event_file" 2>/dev/null | cut -d'"' -f4 | head -n1)
    if [ -z "$commit" ]; then commit=$(grep -o '"commit":"[^"]*"' "$event_file" 2>/dev/null | cut -d'"' -f4 | head -n1); fi
    if [ -n "$commit" ] && git merge-base --is-ancestor "$commit" HEAD 2>/dev/null; then
      lineage="$cand"
      break
    fi
  done
fi
if [ -z "$lineage" ]; then
  if biggz sdd-status --json 2>/dev/null | grep -q '"verifyReport": "done"'; then
    exit 0
  fi
  # Three RDD states: enabled (block), disabled (allow), unknown (never a
  # silent skip). A failed or absent producer is unknown and fails closed.
  rdd_rc=0
  rdd_out=$(biggz rdd status 2>/dev/null) || rdd_rc=$?
  if [ "$rdd_rc" -ne 0 ]; then
    echo "biggz RDD gate blocked push: RDD status unavailable (biggz rdd status failed or biggz is not on PATH) — unknown is never a silent skip. Fix PATH or install biggz, or set SKIP_RDD_GATE=1 to bypass explicitly." >&2
    exit 1
  fi
  case "$rdd_out" in
    *"RDD Status: enabled"*)
      echo "biggz RDD gate blocked: enabled but unmanaged (no lineage). Hint: biggz review start or biggz rdd disable" >&2
      exit 1
      ;;
    *"RDD Status: disabled"*)
      exit 0
      ;;
    *)
      echo "biggz RDD gate blocked push: RDD status unknown (unrecognized biggz rdd status output) — unknown is never a silent skip. Upgrade biggz, or set SKIP_RDD_GATE=1 to bypass explicitly." >&2
      exit 1
      ;;
  esac
fi
if command -v biggz >/dev/null 2>&1; then
  set +e
  output=$(biggz review gate pre-push "$lineage" --json 2>&1)
  rc=$?
  echo "$output" >&2
  if echo "$output" | grep -q '"delivery"[[:space:]]*:[[:space:]]*"disabled'; then
    exit 0
  fi
  if echo "$output" | grep -q '"allowed"[[:space:]]*:[[:space:]]*false'; then
    echo "biggz RDD gate blocked push: Hint: biggz review start or biggz rdd disable" >&2
    exit 1
  fi
  exit $rc
fi
echo "biggz RDD gate notice: biggz is not on PATH — review gate not enforced for this push (explicit notice, never a silent skip)." >&2
exit 0
